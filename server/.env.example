# ── MongoDB Atlas ─────────────────────────────────────────────
# Paste the connection string from Atlas (Connect → Drivers).
# Remember to replace <password> and add the DB name, e.g. .../sadguru
MONGODB_URI=mongodb+srv://user:<password>@cluster0.xxxxx.mongodb.net/sadguru?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────
# Any long random string. Used to sign owner login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Owner login. Run `npm run seed:admin` after setting these.
ADMIN_EMAIL=ambikamantole@gmail.com
ADMIN_PASSWORD=ambika123

# ── Cloudinary (image + PDF storage) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Server ────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://itsanjali2410.github.io

# ── Email notifications for new leads (optional) ──────────────
# SMTP creds; if blank, lead emails are skipped (still saved to DB).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=ambikamantole@gmail.com

# AI brochure extraction (optional) — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
