# Base URL of the backend API. No trailing slash.
#
# Production: LEAVE UNSET. The site calls /api/* on its own domain and a
# Vercel rewrite (frontend/vercel.json) proxies that to the Render backend
# server-side — so the browser never makes a cross-origin request and CORS
# cannot break the site. Setting this in Vercel would reintroduce that risk.
#
# Local dev only: point at the Express server started by `npm run dev` in server/.
VITE_API_URL=http://localhost:4000
