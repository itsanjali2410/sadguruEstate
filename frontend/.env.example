# Base URL of the backend API. No trailing slash.
#
# Production: LEAVE UNSET. The API is served from /api on the same Vercel
# domain, so the app uses a relative path and makes no cross-origin call.
# Setting this in Vercel would reintroduce the bug it was set to fix.
#
# Local dev only: point at the Express server started by `npm run dev` in server/.
VITE_API_URL=http://localhost:4000
